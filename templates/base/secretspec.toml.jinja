#:schema https://secretspec.dev/schema/secretspec.schema.json
# The secrets this repository's scripts and checks read. Declare a new one with
# `secretspec add <NAME> --description "<purpose>"`, and read it with
# `secretspec run -- <command>` or `secretspec get <NAME>`. No value ever enters
# the repository. On a workstation, values come from the provider the owner's
# secretspec config names, the Keychain by default. The ci profile reads them
# from the job environment only.
# Reference: https://secretspec.dev/reference/configuration/

[project]
name = "${NAME}"
revision = "1.0"

[profiles.default]
GH_TOKEN = { description = "GitHub token for the gh calls in scripts/; a gh login works without it", required = false }

[profiles.ci.defaults]
providers = ["env://"]
