[0.013, "o", "\u001b[2J\u001b[H"]
[0.213, "o", "\r\n\u001b[2m# Scenario: KEYS names signers by fingerprint\u001b[0m\r\n"]
[1.42, "o", "\u001b[2m# The trust anchor is one readable line: a pin and the addresses the bytes come from. No key block.\u001b[0m\r\n"]
