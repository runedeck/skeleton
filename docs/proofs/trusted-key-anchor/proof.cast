[2.846, "o", "# Trusted signers for this repository (docs/specs/trusted-key-anchor).\r\n# One line per signer: the pinned fingerprint, then the addresses whose Web\r\n# Key Directory (or GitHub key list) supplies the bytes, tried in order.\r\n# scripts/trusted-keys resolves this file; nothing is trusted but the pin.\r\n#\r\n# The YubiKey signing subkey of Martin Zeman (primary 786F851F8AE345F5A98B822EC92F47D08BCD9F72).\r\nsigner 29DD2145CE7A818929459B2649F08103D3DA399E git@martinzeman.net N4M3Z@users.noreply.github.com\r\n"]
[4.358, "o", "\r\n\u001b[2m# Scenario: The pin admits the key that carries it\u001b[0m\r\n"]
[5.566, "o", "\u001b[2m# The pinned fingerprint is a signing subkey; the resolver imports its primary and reports the source.\u001b[0m\r\n"]
